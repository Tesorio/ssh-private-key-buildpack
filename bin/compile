#!/usr/bin/env bash

function indent() {
	c='s/^/       /'
	case $(uname) in
		Darwin) sed -l "$c";;
		*)      sed -u "$c";;
	esac
}

ENV_DIR=${3:-}

# One token can read several private repos; a deploy key (SSH_KEY) only reads one.
# Written to $HOME, not the build dir, so the token does not end up in the slug.
if [ -s "$ENV_DIR/GITHUB_TOKEN" ]; then
	echo "-----> Rewriting GitHub SSH URLs to HTTPS with GITHUB_TOKEN"
	github_url="https://x-access-token:$(cat "$ENV_DIR/GITHUB_TOKEN")@github.com/"
	git config --global --add url."$github_url".insteadOf "ssh://git@github.com/"
	git config --global --add url."$github_url".insteadOf "git@github.com:"
fi

ssh_key="$(cat $ENV_DIR/SSH_KEY 2>/dev/null)"
ssh_hosts=${SSH_HOSTS:-"git@github.com"}

if [ "$ssh_key" != "" ]; then
	echo "-----> Running SSH private key setup"

	# The .ssh needs to be located in the home directory which is different to the
	# home directory of the built machine. The symlink resolves the issue.
	mkdir "$1/.ssh"
	ln -s "$1/.ssh" "$HOME/.ssh"
	echo "$ssh_key" | base64 --decode > "$HOME/.ssh/id_rsa"

	IFS=',' read -ra HOST <<< "$ssh_hosts"
	for i in "${HOST[@]}"; do
		ssh -oStrictHostKeyChecking=no -T $i 2>&1 | indent
	done

	exit 0
else
	echo "-----> No SSH private key"
fi
